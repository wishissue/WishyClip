+                        val w = (original.width * scale).toInt().coerceAtLeast(1)
+                        val h = (original.height * scale).toInt().coerceAtLeast(1)
+                        val out = Bitmap.createScaledBitmap(original, w, h, true)
+                        if (out !== original) original.recycle()
+                        out
+                    }
+                }
+            } catch (e: Exception) {
+                null
+            }
