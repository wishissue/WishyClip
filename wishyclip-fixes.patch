+            val r = pixels!![i * 3].toInt() and 0xFF
+            val g = pixels!![i * 3 + 1].toInt() and 0xFF
+            val b = pixels!![i * 3 + 2].toInt() and 0xFF
+            val rq = (r * 7 + 127) / 255
+            val gq = (g * 7 + 127) / 255
+            val bq = (b * 3 + 127) / 255
+            indexedPixels!![i] = ((rq shl 5) or (gq shl 2) or bq).toByte()
+        }
+        colorTab = tab
